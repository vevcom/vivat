{"@type":"upsert","object":"Domain","matchOn":["name"],"value":{"dom":{"name":"omega.ntnu.no","description":"Omega's mail domain. The aliases on it are omegaweb-next's lists."}}}
{"@type":"upsert","object":"Certificate","matchOn":["certificate"],"value":{"cert":{"certificate":{"@type":"File","filePath":"/etc/stalwart/tls/tls.crt"},"privateKey":{"@type":"File","filePath":"/etc/stalwart/tls/tls.key"}}}}
{"@type":"update","object":"SystemSettings","value":{"defaultHostname":"sanctus.omega.ntnu.no","defaultDomainId":"#dom","defaultCertificateId":"#cert"}}
{"@type":"upsert","object":"MtaRoute","matchOn":["name"],"value":{"mailgw":{"@type":"Relay","name":"mailgw","description":"NTNU's mail gateway relays for the whole of NTNU's network by source address","host":"mailgw.ntnu.no","port":25,"implicitTls":false,"allowInvalidCerts":false}}}
{"@type":"update","object":"MtaOutboundStrategy","value":{"route":{"match":{"0":{"if":"is_local_domain(rcpt_domain)","then":"'local'"}},"else":"'mailgw'"}}}
{"@type":"upsert","object":"Domain","matchOn":["name"],"value":{"mailboxes":{"name":"mail.omega.ntnu.no","description":"The webmail's host: the domain of the accounts that sign in through omegaweb-next"}}}
{"@type":"upsert","object":"Directory","matchOn":["description"],"value":{"omegaweb":{"@type":"Oidc","description":"omegaweb-next signs users in","issuerUrl":"https://login.omega.ntnu.no","claimUsername":"preferred_username","usernameDomain":"mail.omega.ntnu.no","claimName":"name","claimGroups":null,"acceptedAudiences":{"mail.omega.ntnu.no":true}}}}
{"@type":"update","object":"Authentication","value":{"directoryId":"#omegaweb"}}
{"@type":"update","object":"MtaStageRcpt","value":{"script":{"match":{"0":{"if":"is_empty(authenticated_as) && rcpt_domain == 'forward.mail.omega.ntnu.no'","then":"'refuse-recipient'"}},"else":"false"}}}
{"@type":"create","object":"Action","value":{"reload":{"@type":"ReloadSettings"}}}
